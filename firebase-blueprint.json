{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with business details and PIN verification metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "businessName": { "type": "string" },
        "department": { "type": "string" },
        "role": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "pinHash": { "type": "string" },
        "lastPinVerifiedTimestamp": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "name"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Conversation between participants",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "isGroup": { "type": "boolean" },
        "participantIds": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastTimestamp": { "type": "number" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "participantIds"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "type": { "type": "string" }
      },
      "required": ["id", "conversationId", "senderId", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profiles"
    },
    "/conversations/{conversationId}": {
      "schema": "#/entities/Conversation",
      "description": "Conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "#/entities/Message",
      "description": "Messages in conversation"
    }
  }
}
